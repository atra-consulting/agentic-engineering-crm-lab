        }
      },
      "PageQuery": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Page number, 0-indexed. A missing, negative or non-numeric value falls back to 0.",
        "schema": {
          "type": "integer",
          "default": 0
        }
      },
      "SizeQuery": {
        "name": "size",
        "in": "query",
        "required": false,
        "description": "Page size. Default 10. Values above 200 are capped at 200. A missing, non-positive or non-numeric value falls back to 10.",
        "schema": {
          "type": "integer",
          "default": 10
        }
      },
      "SortQuery": {
        "name": "sort",
        "in": "query",
        "required": false,
        "description": "field,direction; direction in any case (asc/ASC/desc/DESC).\nThe allowed fields are the operation's `x-sort-fields`; the default is its\n`x-default-sort`. An unknown field answers 400 with the message\n`Ungültiges Sortierfeld: <field>`. A missing or unknown direction falls\nback to the default direction.\n",
        "schema": {
          "type": "string"
        }
      },
      "SearchQuery": {
        "name": "search",
        "in": "query",
        "required": false,
        "description": "Case-insensitive substring filter. The operation description names the matched field.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid input. `message` names the problem; `fieldErrors` maps fields to German texts.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Not authenticated (no session, or a missing or wrong token).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated, but the role is not allowed (`Zugriff verweigert`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Record not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflict with the current data, for example a duplicate name or an invalid state change.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}
